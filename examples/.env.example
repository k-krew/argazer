# ArgoCD Connection
AG_ARGOCD_URL=argocd.example.com
AG_ARGOCD_USERNAME=admin
AG_ARGOCD_PASSWORD=your-password-here
AG_ARGOCD_INSECURE=false

# Search Scope
AG_PROJECTS=*
AG_APP_NAMES=*
# AG_LABELS=type=operator,environment=production  # Format: key1=value1,key2=value2

# Notification Channel (slack, webhook, or empty for console only)
AG_NOTIFICATION_CHANNEL=slack

# Slack Settings
AG_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Generic Webhook Settings (sends JSON with "subject" and "message" fields)
AG_WEBHOOK_URL=https://your-webhook-endpoint.example.com/notify

# General Settings
AG_VERBOSITY=normal  # "normal" | "full" | "off"
# AG_SOURCE_NAME=chart-repo  # Optional: for multi-source apps, check only the source with this name
AG_CONCURRENCY=10

# Notify On (major, minor, patch)
# major: Report all versions (default)
# minor: Only the same major version
# patch: Only the same major.minor
AG_NOTIFY_ON=major

# Fail On (none, any, patch, minor, major)
# Exit code 2 when updates of this severity or higher are found, for use as a CI/CD gate
# none: Only report the updates, never fail the run (default)
AG_FAIL_ON=none

